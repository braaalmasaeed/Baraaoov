name: Build Flutter APK
on:
  push:
    branches: [ main, master, baraaov ]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Extract Project ZIP
        run: |
          unzip muezzin_project.zip -d extracted_project
          
      - name: Setup Flutter SDK
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.19.x'
          channel: 'stable'
          
      - name: Get Dependencies and Build APK
        run: |
          cd extracted_project/$(ls extracted_project)
          flutter pub get
          flutter build apk --release
          
      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release
          path: extracted_project/**/build/app/outputs/flutter-apk/app-release.apk
